<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>MYG.Electrical</AssemblyName>
    <RootNamespace>MYG.Electrical.App</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- Velopack kurulum/güncelleme kancaları uygulama başlamadan çalışmalı -->
    <StartupObject>MYG.Electrical.App.Program</StartupObject>
    <!-- Yayında yalnız Türkçe ve İngilizce WPF/.NET kaynakları (menü, iletişim kutusu metinleri) -->
    <SatelliteResourceLanguages>tr;en</SatelliteResourceLanguages>
    <ApplicationIcon>Assets\myg-electrical.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\MYG.Electrical.Core\MYG.Electrical.Core.csproj" />
    <ProjectReference Include="..\MYG.Electrical.Symbols\MYG.Electrical.Symbols.csproj" />
    <ProjectReference Include="..\MYG.Electrical.Drawing\MYG.Electrical.Drawing.csproj" />
    <ProjectReference Include="..\MYG.Electrical.Infrastructure\MYG.Electrical.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\myg-electrical.ico" />
    <Resource Include="Assets\myg-electrical.png" />
    <Content Include="..\..\samples\Demo.myge" Link="Samples\Demo.myge" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\samples\PompaIstasyonu.myge" Link="Samples\PompaIstasyonu.myge" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Dirkster.AvalonDock" />
    <PackageReference Include="Dirkster.AvalonDock.Themes.VS2013" />
    <PackageReference Include="Dirkster.AvalonDock.Serializer.Xml" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Velopack" />
  </ItemGroup>
</Project>

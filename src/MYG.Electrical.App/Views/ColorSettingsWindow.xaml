<Window x:Class="MYG.Electrical.App.Views.ColorSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Renk ayarları" Icon="/Assets/myg-electrical.ico"
        Width="460" Height="600" MinHeight="400" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource AnthraciteBrush}" Foreground="{StaticResource TextBrush}">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,8"
                   Text="Renkler yalnızca görsel yardımdır: potansiyelin adı (L1, +24V...), türü ve gerilimi her zaman ayrıca yazılır. Siyah-beyaz PDF için Dosya menüsündeki seçeneği kullanın." />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <TextBlock x:Name="ErrorText" Foreground="#FFD32F2F" VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="Wrap" MaxWidth="200" />
            <Button Content="Varsayılana dön" Command="{Binding ResetCommand}" MinWidth="110" Margin="0,0,8,0" />
            <Button Content="Kaydet" IsDefault="True" MinWidth="80" Margin="0,0,8,0" Click="OnSaveClick" />
            <Button Content="İptal" IsCancel="True" MinWidth="80" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding Hex, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                            <Border Grid.Column="2" Margin="6,2,0,2" Background="{Binding Swatch}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="2" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>

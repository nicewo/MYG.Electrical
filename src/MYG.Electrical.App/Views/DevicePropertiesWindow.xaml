<Window x:Class="MYG.Electrical.App.Views.DevicePropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Icon="/Assets/myg-electrical.ico"
        Width="760" Height="560" MinWidth="600" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource AnthraciteBrush}" Foreground="{StaticResource TextBrush}">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,6,12,6" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Margin" Value="0,3" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <TextBlock x:Name="ErrorText" Foreground="#FFD32F2F" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Button Content="Tamam" IsDefault="True" MinWidth="90" Margin="0,0,8,0" Click="OnOkClick" />
            <Button Content="İptal" IsCancel="True" MinWidth="90" />
        </StackPanel>
        <TabControl>
            <TabItem Header="Genel">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="140" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Etiket (IEC 81346)" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Column="1" Text="{Binding Reference}" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="1" Text="Açıklama" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Description}" />
                    <TextBlock Grid.Row="2" Text="Bu parçanın işlev metni" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Function}" ToolTip="Ör. PLC kanalı için 'Konveyör çalışıyor'" />
                    <TextBlock Grid.Row="3" Text="Yer (+)" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Location}" ToolTip="Montaj yeri, ör. +PANO1" />
                    <TextBlock Grid.Row="4" Text="Kategori" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Category}" />
                    <TextBlock Grid.Row="5" Text="Sembol" Style="{StaticResource FieldLabel}" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SymbolName}" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="6" Text="Kütüphane" Style="{StaticResource FieldLabel}" />
                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding LibraryVersion}" VerticalAlignment="Center" />
                    <Border Grid.Column="2" Grid.RowSpan="7" Margin="12,0,0,0" Background="White" CornerRadius="3" Padding="6">
                        <Image x:Name="PreviewImage" Stretch="Uniform" />
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Elektriksel veri">
                <DockPanel Margin="12">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <Button Content="Özellik ekle" Command="{Binding AddPropertyCommand}" MinWidth="110" />
                        <TextBlock Text="Gerilim, akım, güç, bobin gerilimi... Sembol ve cihaz kütüphanesinden gelen değerler değiştirilebilir."
                                   Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Properties}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Özellik" Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Width="220" />
                            <DataGridTextColumn Header="Değer" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                            <DataGridTemplateColumn Width="40">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="✕" ToolTip="Kaldır" Padding="4,0"
                                                Command="{Binding DataContext.RemovePropertyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Bağlantılar / Pinler">
                <DockPanel Margin="12">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"
                               Text="Görünen ad şemada yazan bağlantı tanımıdır (ör. 13 → 23). Kablolar pin kimliğine bağlı olduğu için adı değiştirmek bağlantıyı bozmaz." />
                    <DataGrid ItemsSource="{Binding Pins}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Pin" Binding="{Binding PinId}" IsReadOnly="True" Width="70" />
                            <DataGridTextColumn Header="Görünen ad" Binding="{Binding Label, UpdateSourceTrigger=PropertyChanged}" Width="110" />
                            <DataGridTextColumn Header="İşlev" Binding="{Binding Function}" IsReadOnly="True" Width="*" />
                            <DataGridTextColumn Header="Bağlantı / potansiyel" Binding="{Binding Connection}" IsReadOnly="True" Width="180" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Üretici">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Üretici" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Column="1" Text="{Binding Manufacturer}" />
                    <TextBlock Grid.Row="1" Text="Model / tip" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Model}" />
                    <TextBlock Grid.Row="2" Text="Sipariş numarası" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding OrderNumber}" />
                    <TextBlock Grid.Row="3" Text="Cihaz kütüphanesi" Style="{StaticResource FieldLabel}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TemplateId}" VerticalAlignment="Center" />
                </Grid>
            </TabItem>
            <TabItem Header="Kontaklar">
                <DockPanel Margin="12">
                    <TextBlock DockPanel.Dock="Top" Text="{Binding ContactSummary}" FontWeight="SemiBold" />
                    <DataGrid ItemsSource="{Binding Contacts}" IsReadOnly="True">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Warning}" Value="True">
                                        <Setter Property="Foreground" Value="#FFD32F2F" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Kontak" Binding="{Binding First}" Width="*" />
                            <DataGridTextColumn Header="Durum" Binding="{Binding Second}" Width="140" />
                            <DataGridTextColumn Header="Konum" Binding="{Binding Third}" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Çapraz referanslar">
                <DockPanel Margin="12">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"
                               Text="Aynı etiketi taşıyan bütün parçalar. Konum /sayfa.kolon olarak yazılır (kolonlar çerçevedeki 0–9 şerididir)." />
                    <DataGrid ItemsSource="{Binding CrossRefs}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Konum" Binding="{Binding First}" Width="90" />
                            <DataGridTextColumn Header="Parça" Binding="{Binding Second}" Width="*" />
                            <DataGridTextColumn Header="Pinler / işlev" Binding="{Binding Third}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Dokümantasyon">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Datasheet" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Column="1" Text="{Binding Datasheet, UpdateSourceTrigger=PropertyChanged}" ToolTip="Dosya yolu veya web adresi" />
                    <Button Grid.Column="2" Content="Gözat…" Margin="6,3,0,3" Click="OnBrowseDatasheet" />
                    <Button Grid.Column="3" Content="Aç" Margin="6,3,0,3" Click="OnOpenDatasheet" />
                    <TextBlock Grid.Row="1" Text="Notlar" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" />
                    <TextBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Notes}"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="160" VerticalContentAlignment="Top" />
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>

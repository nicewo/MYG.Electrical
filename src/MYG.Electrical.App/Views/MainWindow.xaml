<Window x:Class="MYG.Electrical.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MYG.Electrical.App.ViewModels"
        xmlns:conv="clr-namespace:MYG.Electrical.App.Converters"
        xmlns:draw="clr-namespace:MYG.Electrical.Drawing;assembly=MYG.Electrical.Drawing"
        xmlns:sym="clr-namespace:MYG.Electrical.Core.Symbols;assembly=MYG.Electrical.Core"
        xmlns:ad="https://github.com/Dirkster99/AvalonDock"
        xmlns:adt="clr-namespace:AvalonDock.Themes;assembly=AvalonDock.Themes.VS2013"
        Title="{Binding Title}"
        Icon="/Assets/myg-electrical.ico"
        Width="1600" Height="950" MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AnthraciteBrush}"
        Foreground="{StaticResource TextBrush}">

    <Window.Resources>
        <conv:EnumEqualsConverter x:Key="EnumEquals" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Özellik satırı şablonları -->
        <DataTemplate DataType="{x:Type vm:SectionRow}">
            <TextBlock Text="{Binding Label}" Style="{StaticResource PanelHeader}" Margin="0,12,0,4" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TextRow}">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=LostFocus}" IsReadOnly="{Binding IsReadOnly}" />
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:NumberRow}">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=LostFocus}" IsReadOnly="{Binding IsReadOnly}" HorizontalContentAlignment="Right" />
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ChoiceRow}">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding Options}" SelectedItem="{Binding Value}" />
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ButtonRow}">
            <Button Content="{Binding Label}" Command="{Binding Command}" Margin="100,6,0,2" HorizontalAlignment="Stretch" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BoolRow}">
            <CheckBox Content="{Binding Label}" IsChecked="{Binding Value}" Margin="100,4,0,4" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FileRow}">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=LostFocus}" />
                <Button Grid.Column="2" Content="…" Command="{Binding BrowseCommand}" Style="{StaticResource ToolButton}" ToolTip="Gözat" />
                <Button Grid.Column="3" Content="✕" Command="{Binding ClearCommand}" Style="{StaticResource ToolButton}" ToolTip="Temizle" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="F1" Command="{Binding UserGuideCommand}" />
        <KeyBinding Key="F7" Command="{Binding RunDrcCommand}" />
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveAsCommand}" />
        <KeyBinding Key="P" Modifiers="Control" Command="{Binding ExportPdfCommand}" />
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
        <KeyBinding Key="C" Modifiers="Control" Command="{Binding CopyCommand}" />
        <KeyBinding Key="X" Modifiers="Control" Command="{Binding CutCommand}" />
        <KeyBinding Key="V" Modifiers="Control" Command="{Binding PasteCommand}" />
        <KeyBinding Key="A" Modifiers="Control" Command="{Binding SelectAllCommand}" />
        <KeyBinding Key="Add" Modifiers="Control" Command="{Binding ZoomInCommand}" />
        <KeyBinding Key="Subtract" Modifiers="Control" Command="{Binding ZoomOutCommand}" />
    </Window.InputBindings>

    <DockPanel>
        <!-- ===== Üst menü ===== -->
        <Menu DockPanel.Dock="Top" Background="{StaticResource AnthraciteBrush}">
            <MenuItem Header="_Dosya">
                <MenuItem Header="_Yeni proje" Command="{Binding NewCommand}" InputGestureText="Ctrl+N" />
                <MenuItem Header="_Aç…" Command="{Binding OpenCommand}" InputGestureText="Ctrl+O" />
                <Separator />
                <MenuItem Header="_Kaydet" Command="{Binding SaveCommand}" InputGestureText="Ctrl+S" />
                <MenuItem Header="_Farklı kaydet…" Command="{Binding SaveAsCommand}" InputGestureText="Ctrl+Shift+S" />
                <Separator />
                <MenuItem Header="Tüm projeyi _PDF'e aktar…" Command="{Binding ExportPdfCommand}" InputGestureText="Ctrl+P" />
                <MenuItem Header="Aktif sayfayı PDF'e aktar…" Command="{Binding ExportPagePdfCommand}" />
                <MenuItem Header="PDF'i siyah-beyaz aktar" IsCheckable="True" IsChecked="{Binding PdfMonochrome}" />
                <Separator />
                <MenuItem Header="Çı_kış" Click="OnExitClick" InputGestureText="Alt+F4" />
            </MenuItem>
            <MenuItem Header="_Düzen">
                <MenuItem Header="Geri al" Command="{Binding UndoCommand}" InputGestureText="Ctrl+Z" />
                <MenuItem Header="İleri al" Command="{Binding RedoCommand}" InputGestureText="Ctrl+Y" />
                <Separator />
                <MenuItem Header="Kes" Command="{Binding CutCommand}" InputGestureText="Ctrl+X" />
                <MenuItem Header="Kopyala" Command="{Binding CopyCommand}" InputGestureText="Ctrl+C" />
                <MenuItem Header="Yapıştır" Command="{Binding PasteCommand}" InputGestureText="Ctrl+V" />
                <MenuItem Header="Sil" Command="{Binding DeleteCommand}" InputGestureText="Del" />
                <Separator />
                <MenuItem Header="Tümünü seç" Command="{Binding SelectAllCommand}" InputGestureText="Ctrl+A" />
                <MenuItem Header="Döndür 90° (seçim / yerleştirme önizlemesi)" Command="{Binding RotateCommand}" InputGestureText="R" />
            </MenuItem>
            <MenuItem Header="_Görünüm">
                <MenuItem Header="Yakınlaştır" Command="{Binding ZoomInCommand}" InputGestureText="Ctrl++" />
                <MenuItem Header="Uzaklaştır" Command="{Binding ZoomOutCommand}" InputGestureText="Ctrl+-" />
                <MenuItem Header="Sayfaya sığdır" Command="{Binding ZoomFitCommand}" InputGestureText="F" />
                <Separator />
                <MenuItem Header="Izgara" IsCheckable="True" IsChecked="{Binding GridVisible}" />
                <MenuItem Header="Izgaraya yakala" IsCheckable="True" IsChecked="{Binding SnapEnabled}" />
                <MenuItem Header="Bağlantı noktası işaretleri" IsCheckable="True" IsChecked="{Binding ShowConnectionPoints}" />
                <MenuItem Header="Paneller" SubmenuOpened="OnPanelsMenuOpened">
                    <MenuItem Header="Proje gezgini" Tag="explorer" Click="OnTogglePanel" IsCheckable="True" />
                    <MenuItem Header="Kütüphane" Tag="library" Click="OnTogglePanel" IsCheckable="True" />
                    <MenuItem Header="Özellikler" Tag="properties" Click="OnTogglePanel" IsCheckable="True" />
                    <MenuItem Header="DRC" Tag="drc" Click="OnTogglePanel" IsCheckable="True" />
                    <MenuItem Header="Mesajlar" Tag="messages" Click="OnTogglePanel" IsCheckable="True" />
                    <MenuItem Header="Çapraz referanslar" Tag="xref" Click="OnTogglePanel" IsCheckable="True" />
                    <MenuItem Header="Proje bilgisi" Tag="projectinfo" Click="OnTogglePanel" IsCheckable="True" />
                    <Separator />
                    <MenuItem Header="Varsayılan düzene dön" Click="OnResetLayout" />
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Ekle">
                <MenuItem Header="Sembol (kütüphaneden seçin)" Command="{Binding SetToolCommand}" CommandParameter="Symbol" />
                <MenuItem Header="Dirsek (90° dönüş)" Command="{Binding SetToolCommand}" CommandParameter="Angle" InputGestureText="D" />
                <MenuItem Header="T bağlantı" Command="{Binding SetToolCommand}" CommandParameter="Tee" InputGestureText="J" />
                <MenuItem Header="Çapraz düğüm (4 yollu)" Command="{Binding SetToolCommand}" CommandParameter="Cross" />
                <MenuItem Header="Metin" Command="{Binding SetToolCommand}" CommandParameter="Text" InputGestureText="T" />
                <Separator />
                <MenuItem Header="Potansiyel">
                    <MenuItem Header="L1" Command="{Binding PlacePotentialCommand}" CommandParameter="L1" />
                    <MenuItem Header="L2" Command="{Binding PlacePotentialCommand}" CommandParameter="L2" />
                    <MenuItem Header="L3" Command="{Binding PlacePotentialCommand}" CommandParameter="L3" />
                    <MenuItem Header="N" Command="{Binding PlacePotentialCommand}" CommandParameter="N" />
                    <MenuItem Header="PE" Command="{Binding PlacePotentialCommand}" CommandParameter="PE" />
                    <Separator />
                    <MenuItem Header="+24V" Command="{Binding PlacePotentialCommand}" CommandParameter="+24V" />
                    <MenuItem Header="0V" Command="{Binding PlacePotentialCommand}" CommandParameter="0V" />
                    <Separator />
                    <MenuItem Header="Diğer (adı sonra girin)" Command="{Binding PlacePotentialCommand}" />
                </MenuItem>
                <MenuItem Header="Sayfa bağlantısı (kesme noktası)" Command="{Binding PlacePageLinkCommand}" />
                <MenuItem Header="Cihaz / PLC tasarımı">
                    <MenuItem Header="Cihaz kutusu (kesikli)" Command="{Binding DrawDeviceBoxCommand}" />
                    <Separator />
                    <MenuItem Header="Giriş pini (X0.0, I0.0...)" Command="{Binding PlaceDevicePinCommand}" CommandParameter="input" />
                    <MenuItem Header="Çıkış pini (Y0.0, Q0.0...)" Command="{Binding PlaceDevicePinCommand}" CommandParameter="output" />
                    <MenuItem Header="Güç + pini (L+, 24V)" Command="{Binding PlaceDevicePinCommand}" CommandParameter="plus" />
                    <MenuItem Header="Güç − pini (M, 0V)" Command="{Binding PlaceDevicePinCommand}" CommandParameter="minus" />
                    <MenuItem Header="PE pini" Command="{Binding PlaceDevicePinCommand}" CommandParameter="pe" />
                    <MenuItem Header="Haberleşme pini (A, B)" Command="{Binding PlaceDevicePinCommand}" CommandParameter="comm" />
                    <MenuItem Header="Diğer pin" Command="{Binding PlaceDevicePinCommand}" />
                    <Separator />
                    <MenuItem Header="Seçimden cihaz oluştur (kütüphaneye ekle)…" Command="{Binding CreateDeviceCommand}" />
                </MenuItem>
                <Separator />
                <MenuItem Header="Resim…" Command="{Binding InsertImageCommand}" />
            </MenuItem>
            <MenuItem Header="Çi_zim">
                <MenuItem Header="Seç" Command="{Binding SetToolCommand}" CommandParameter="Select" InputGestureText="S" />
                <MenuItem Header="Çizgi" Command="{Binding SetToolCommand}" CommandParameter="Line" InputGestureText="L" />
                <MenuItem Header="Dikdörtgen" Command="{Binding SetToolCommand}" CommandParameter="Rectangle" />
            </MenuItem>
            <MenuItem Header="_Sayfa">
                <MenuItem Header="Yeni şema sayfası" Command="{Binding AddSchematicPageCommand}" />
                <MenuItem Header="Yeni kapak sayfası" Command="{Binding AddCoverPageCommand}" />
                <Separator />
                <MenuItem Header="Yukarı taşı" Command="{Binding MovePageUpCommand}" />
                <MenuItem Header="Aşağı taşı" Command="{Binding MovePageDownCommand}" />
                <MenuItem Header="Sonraki sayfa" Command="{Binding NextPageCommand}" InputGestureText="PgDn" />
                <MenuItem Header="Önceki sayfa" Command="{Binding PreviousPageCommand}" InputGestureText="PgUp" />
                <Separator />
                <MenuItem Header="Aktif sayfayı sil" Command="{Binding DeletePageCommand}" />
            </MenuItem>
            <MenuItem Header="_Proje">
                <MenuItem Header="Tasarım kuralları denetimi (DRC)" Command="{Binding RunDrcCommand}" InputGestureText="F7" />
                <Separator />
                <MenuItem Header="Cihazları yeniden numaralandır (IEC 81346)" Command="{Binding RenumberDevicesCommand}" />
                <Separator />
                <MenuItem Header="Kabloları numaralandır (yalnızca eksikler)" Command="{Binding NumberWiresCommand}" CommandParameter="missing" />
                <MenuItem Header="Tüm kabloları yeniden numaralandır" Command="{Binding NumberWiresCommand}" CommandParameter="all" />
            </MenuItem>
            <MenuItem Header="_Raporlar">
                <MenuItem Header="Tüm raporlar (Excel .xlsx)…" Command="{Binding ExportReportsCommand}" />
                <Separator />
                <MenuItem Header="Cihaz listesi (CSV)…" Command="{Binding ExportReportCsvCommand}" CommandParameter="DeviceList" />
                <MenuItem Header="Malzeme listesi / BOM (CSV)…" Command="{Binding ExportReportCsvCommand}" CommandParameter="BillOfMaterials" />
                <MenuItem Header="Klemens planı (CSV)…" Command="{Binding ExportReportCsvCommand}" CommandParameter="TerminalPlan" />
                <MenuItem Header="Kablo listesi (CSV)…" Command="{Binding ExportReportCsvCommand}" CommandParameter="CableList" />
                <MenuItem Header="PLC G/Ç listesi (CSV)…" Command="{Binding ExportReportCsvCommand}" CommandParameter="PlcIoList" />
            </MenuItem>
            <MenuItem Header="_Araçlar">
                <MenuItem Header="Renk ayarları…" Command="{Binding OpenColorSettingsCommand}" />
                <Separator />
                <MenuItem Header="Log klasörünü aç" Command="{Binding OpenLogFolderCommand}" />
            </MenuItem>
            <MenuItem Header="_Yardım">
                <MenuItem Header="Kullanım kılavuzu" Command="{Binding UserGuideCommand}" InputGestureText="F1" />
                <MenuItem Header="Klavye kısayolları" Command="{Binding ShortcutsCommand}" />
                <MenuItem Header="Örnek projeler">
                    <MenuItem Header="Pompa istasyonu (7 sayfa)" Command="{Binding OpenSampleCommand}" CommandParameter="PompaIstasyonu.myge" />
                    <MenuItem Header="Kamara fırını, gaz brülörlü (17 sayfa)" Command="{Binding OpenSampleCommand}" CommandParameter="KamaraFirin.myge" />
                </MenuItem>
                <Separator />
                <MenuItem Header="GitHub kaynak kodu" Command="{Binding SourceCodeCommand}" />
                <MenuItem Header="Hata bildir / öneri" Command="{Binding ReportIssueCommand}" />
                <MenuItem Header="MYG Tech web sitesi" Command="{Binding WebsiteCommand}" />
                <Separator />
                <MenuItem Header="Güncellemeleri denetle" Command="{Binding CheckUpdatesCommand}" />
                <MenuItem Header="MYG Electrical hakkında" Command="{Binding AboutCommand}" />
            </MenuItem>
        </Menu>

        <!-- ===== Araç çubuğu ===== -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelHeaderBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1">
            <StackPanel Orientation="Horizontal" Margin="6,3">
                <ToggleButton Style="{StaticResource ToolToggle}" ToolTip="Seç (S)"
                              IsChecked="{Binding ActiveTool, Converter={StaticResource EnumEquals}, ConverterParameter=Select}">
                    <Path Style="{StaticResource ToolIcon}" Fill="{Binding Stroke, RelativeSource={RelativeSource Self}}" Data="M0,0 L0,12 L3.5,9 L6,14 L8,13 L5.5,8 L10,8 Z" />
                </ToggleButton>
                <ToggleButton Style="{StaticResource ToolToggle}" ToolTip="Çizgi (L)"
                              IsChecked="{Binding ActiveTool, Converter={StaticResource EnumEquals}, ConverterParameter=Line}">
                    <Path Style="{StaticResource ToolIcon}" Data="M1,13 L13,1" />
                </ToggleButton>
                <ToggleButton Style="{StaticResource ToolToggle}" ToolTip="Dikdörtgen"
                              IsChecked="{Binding ActiveTool, Converter={StaticResource EnumEquals}, ConverterParameter=Rectangle}">
                    <Path Style="{StaticResource ToolIcon}" Data="M1,3 H13 V11 H1 Z" />
                </ToggleButton>
                <ToggleButton Style="{StaticResource ToolToggle}" ToolTip="Metin (T)"
                              IsChecked="{Binding ActiveTool, Converter={StaticResource EnumEquals}, ConverterParameter=Text}">
                    <TextBlock Text="A" FontWeight="Bold" FontSize="15" Width="16" TextAlignment="Center" />
                </ToggleButton>
                <ToggleButton Style="{StaticResource ToolToggle}" ToolTip="Sembol ekle (kütüphaneden seçili sembol)"
                              IsChecked="{Binding ActiveTool, Converter={StaticResource EnumEquals}, ConverterParameter=Symbol}">
                    <Path Style="{StaticResource ToolIcon}" Data="M7,0 V4 M3,4 H11 V10 H3 Z M7,10 V14" />
                </ToggleButton>
                <ToggleButton Style="{StaticResource ToolToggle}" ToolTip="Dirsek — 90° dönüş noktası (D) · R: yön"
                              IsChecked="{Binding ActiveTool, Converter={StaticResource EnumEquals}, ConverterParameter=Angle}">
                    <Path Style="{StaticResource ToolIcon}" Data="M7,14 V7 H14" />
                </ToggleButton>
                <ToggleButton Style="{StaticResource ToolToggle}" ToolTip="T bağlantı — 3 yollu düğüm (J) · R: yön"
                              IsChecked="{Binding ActiveTool, Converter={StaticResource EnumEquals}, ConverterParameter=Tee}">
                    <Path Style="{StaticResource ToolIcon}" Fill="{Binding Stroke, RelativeSource={RelativeSource Self}}"
                          Data="M0,5 H14 M7,5 V14 M5.5,5 A1.5,1.5 0 1 1 8.5,5 A1.5,1.5 0 1 1 5.5,5 Z" />
                </ToggleButton>
                <ToggleButton Style="{StaticResource ToolToggle}" ToolTip="Çapraz düğüm — 4 yollu, kesişen hatları birleştirir"
                              IsChecked="{Binding ActiveTool, Converter={StaticResource EnumEquals}, ConverterParameter=Cross}">
                    <Path Style="{StaticResource ToolIcon}" Fill="{Binding Stroke, RelativeSource={RelativeSource Self}}"
                          Data="M0,7 H14 M7,0 V14 M5.5,7 A1.5,1.5 0 1 1 8.5,7 A1.5,1.5 0 1 1 5.5,7 Z" />
                </ToggleButton>

                <Button Style="{StaticResource ToolButton}" ToolTip="Potansiyel +24V (diğerleri: Ekle → Potansiyel)" Command="{Binding PlacePotentialCommand}" CommandParameter="+24V">
                    <Path Style="{StaticResource ToolIcon}" Data="M7,14 V5 M3,5 H11 M5,2.5 H9 M7,0.5 V4.5" />
                </Button>
                <Button Style="{StaticResource ToolButton}" ToolTip="Sayfa bağlantısı — aynı adlı bağlantılar sayfalar arasında birleşir" Command="{Binding PlacePageLinkCommand}">
                    <Path Style="{StaticResource ToolIcon}" Data="M0,7 H5 M5,4 H10 L13,7 L10,10 H5 Z" />
                </Button>
                <Button Style="{StaticResource ToolButton}" ToolTip="Cihaz / PLC kutusu (kesikli dikdörtgen)" Command="{Binding DrawDeviceBoxCommand}">
                    <Rectangle Width="15" Height="11" Stroke="{StaticResource TextBrush}" StrokeThickness="1.3" StrokeDashArray="3 2" />
                </Button>
                <Button Style="{StaticResource ToolButton}" ToolTip="Giriş pini — X0.0, X0.1 ... kendiliğinden devam eder (Çıkış/Güç pinleri: Ekle → Cihaz / PLC tasarımı)" Command="{Binding PlaceDevicePinCommand}" CommandParameter="input">
                    <Path Style="{StaticResource ToolIcon}" Data="M7,1 V12 M4,12 H10 M5.5,2.5 A1.5,1.5 0 1 1 8.5,2.5 A1.5,1.5 0 1 1 5.5,2.5" />
                </Button>
                <Button Style="{StaticResource ToolButton}" ToolTip="Çıkış pini — Y0.0, Y0.1 ..." Command="{Binding PlaceDevicePinCommand}" CommandParameter="output">
                    <Path Style="{StaticResource ToolIcon}" Data="M7,2 V13 M4,2 H10 M5.5,11.5 A1.5,1.5 0 1 1 8.5,11.5 A1.5,1.5 0 1 1 5.5,11.5" />
                </Button>
                <Button Style="{StaticResource ToolButton}" ToolTip="Seçimden cihaz oluştur — kutu ve pinleri seçin, ad verin (ör. Delta AS228T); sol listeye eklenir" Command="{Binding CreateDeviceCommand}">
                    <TextBlock Text="+C" FontWeight="Bold" FontSize="12" Width="18" TextAlignment="Center" />
                </Button>

                <Button Style="{StaticResource ToolButton}" ToolTip="Kabloları numaralandır (eksikler)" Command="{Binding NumberWiresCommand}" CommandParameter="missing">
                    <TextBlock Text="#" FontWeight="Bold" FontSize="14" Width="16" TextAlignment="Center" />
                </Button>

                <Button Style="{StaticResource ToolButton}" ToolTip="Resim ekle (saydamlık ayarlı)" Command="{Binding InsertImageCommand}">
                    <Path Style="{StaticResource ToolIcon}" Data="M1,2 H13 V12 H1 Z M1,10 L5,6 L8,9 L10,7 L13,10 M9.5,4.5 A1,1 0 1 1 9.5,4.6" />
                </Button>

                <Rectangle Width="1" Margin="6,4" Fill="{StaticResource BorderBrush}" />

                <Button Style="{StaticResource ToolButton}" ToolTip="Sil (Del)" Command="{Binding DeleteCommand}">
                    <Path Style="{StaticResource ToolIcon}" Data="M2,2 L12,12 M12,2 L2,12" />
                </Button>
                <Button Style="{StaticResource ToolButton}" ToolTip="Döndür 90° (R)" Command="{Binding RotateCommand}">
                    <Path Style="{StaticResource ToolIcon}" Data="M12,7 A5,5 0 1 1 7,2 M7,2 L10,0 M7,2 L9,5" />
                </Button>
                <Button Style="{StaticResource ToolButton}" ToolTip="Geri al (Ctrl+Z)" Command="{Binding UndoCommand}">
                    <Path Style="{StaticResource ToolIcon}" Data="M4,2 L1,5 L4,8 M1,5 H9 A4,4 0 0 1 9,13 H5" />
                </Button>
                <Button Style="{StaticResource ToolButton}" ToolTip="İleri al (Ctrl+Y)" Command="{Binding RedoCommand}">
                    <Path Style="{StaticResource ToolIcon}" Data="M10,2 L13,5 L10,8 M13,5 H5 A4,4 0 0 0 5,13 H9" />
                </Button>

                <Rectangle Width="1" Margin="6,4" Fill="{StaticResource BorderBrush}" />

                <Button Style="{StaticResource ToolButton}" ToolTip="Yakınlaştır" Command="{Binding ZoomInCommand}">
                    <Path Style="{StaticResource ToolIcon}" Data="M6,1 A5,5 0 1 1 6,11 A5,5 0 1 1 6,1 Z M9.5,9.5 L14,14 M3.5,6 H8.5 M6,3.5 V8.5" />
                </Button>
                <Button Style="{StaticResource ToolButton}" ToolTip="Uzaklaştır" Command="{Binding ZoomOutCommand}">
                    <Path Style="{StaticResource ToolIcon}" Data="M6,1 A5,5 0 1 1 6,11 A5,5 0 1 1 6,1 Z M9.5,9.5 L14,14 M3.5,6 H8.5" />
                </Button>
                <Button Style="{StaticResource ToolButton}" ToolTip="Sayfaya sığdır (F)" Command="{Binding ZoomFitCommand}">
                    <Path Style="{StaticResource ToolIcon}" Data="M1,5 V1 H5 M9,1 H13 V5 M13,9 V13 H9 M5,13 H1 V9" />
                </Button>

                <Rectangle Width="1" Margin="6,4" Fill="{StaticResource BorderBrush}" />

                <ToggleButton Style="{StaticResource ToolToggle}" ToolTip="Izgarayı göster/gizle" IsChecked="{Binding GridVisible}">
                    <Path Style="{StaticResource ToolIcon}" Data="M1,1 H13 V13 H1 Z M5,1 V13 M9,1 V13 M1,5 H13 M1,9 H13" StrokeThickness="1" />
                </ToggleButton>
                <ToggleButton Style="{StaticResource ToolToggle}" ToolTip="Izgaraya yakalamayı aç/kapat" IsChecked="{Binding SnapEnabled}">
                    <Path Style="{StaticResource ToolIcon}" Data="M3,1 V8 A4,4 0 0 0 11,8 V1 M3,4 H6 M8,4 H11" />
                </ToggleButton>

                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusText}" Margin="16,0,0,0" />
            </StackPanel>
        </Border>

        <!-- ===== Alt durum çubuğu ===== -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelHeaderBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Height="26">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding VersionText}" Style="{StaticResource StatusText}" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding ActivePageText}" Style="{StaticResource StatusText}" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding CursorText}" Style="{StaticResource StatusText}" MinWidth="170" />
                    <TextBlock Text="│" Style="{StaticResource StatusText}" />
                    <TextBlock Text="{Binding ZoomText}" Style="{StaticResource StatusText}" MinWidth="60" />
                    <TextBlock Text="│" Style="{StaticResource StatusText}" />
                    <TextBlock Text="{Binding GridText}" Style="{StaticResource StatusText}" />
                    <TextBlock Text="│" Style="{StaticResource StatusText}" />
                    <TextBlock Text="{Binding WireCountText}" Style="{StaticResource StatusText}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Yerleştirilebilir paneller (Visual Studio gibi): kapat, aç, sürükle, yüzdür, otomatik gizle ===== -->
        <ad:DockingManager x:Name="Dock" AllowMixedOrientation="True">
            <ad:DockingManager.Theme>
                <adt:Vs2013DarkTheme />
            </ad:DockingManager.Theme>
            <ad:LayoutRoot>
                <ad:LayoutPanel Orientation="Horizontal">
                    <ad:LayoutAnchorablePaneGroup Orientation="Vertical" DockWidth="280">
                        <ad:LayoutAnchorablePane DockHeight="1*">
                            <ad:LayoutAnchorable ContentId="explorer" Title="Proje gezgini" CanClose="False" CanHide="True">
                                <DockPanel x:Name="ExplorerPanel" Background="{StaticResource PanelBrush}">
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,2">
                                        <Button Style="{StaticResource ToolButton}" Content="+" FontWeight="Bold" ToolTip="Yeni şema sayfası" Command="{Binding AddSchematicPageCommand}" />
                                        <Button Style="{StaticResource ToolButton}" Content="▲" ToolTip="Sayfayı yukarı taşı" Command="{Binding MovePageUpCommand}" />
                                        <Button Style="{StaticResource ToolButton}" Content="▼" ToolTip="Sayfayı aşağı taşı" Command="{Binding MovePageDownCommand}" />
                                        <Button Style="{StaticResource ToolButton}" Content="✕" ToolTip="Aktif sayfayı sil" Command="{Binding DeletePageCommand}" />
                                    </StackPanel>
                                    <TreeView ItemsSource="{Binding ProjectTree}" BorderThickness="0" Background="Transparent"
                                              SelectedItemChanged="OnTreeSelectedItemChanged">
                                        <TreeView.Resources>
                                            <HierarchicalDataTemplate DataType="{x:Type vm:ProjectNodeViewModel}" ItemsSource="{Binding Pages}">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            </HierarchicalDataTemplate>
                                            <DataTemplate DataType="{x:Type vm:PageItemViewModel}">
                                                <StackPanel Margin="0,1">
                                                    <TextBlock Text="{Binding Display}" />
                                                    <TextBlock Text="{Binding Details}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </TreeView.Resources>
                                        <TreeView.ItemContainerStyle>
                                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                                <Setter Property="IsExpanded" Value="True" />
                                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                            </Style>
                                        </TreeView.ItemContainerStyle>
                                    </TreeView>
                                </DockPanel>
                            </ad:LayoutAnchorable>
                        </ad:LayoutAnchorablePane>
                        <ad:LayoutAnchorablePane DockHeight="2*">
                            <ad:LayoutAnchorable ContentId="library" Title="Kütüphane" CanClose="False" CanHide="True">
                                <DockPanel x:Name="LibraryPanel" Background="{StaticResource PanelBrush}">
                                    <!-- Kütüphane: semboller ve cihazlar ayrı -->
                                    <StackPanel DockPanel.Dock="Top" DataContext="{Binding Library}">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,4,6,0">
                                                <RadioButton Content="Semboller" IsChecked="{Binding IsSymbolMode}" Margin="0,0,8,0" ToolTip="IEC 60617 sembol kütüphanesi" />
                                                <RadioButton Content="Cihazlar" IsChecked="{Binding IsDeviceMode}" ToolTip="Ürün bilgili cihaz kütüphanesi (sembolden ayrı)" />
                                            </StackPanel>
                                            <TextBlock Text="Semboller ve cihazlar" Foreground="{StaticResource MutedTextBrush}" Margin="8,6,0,0" />
                                        </DockPanel>
                                        <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Margin="8,0,8,4"
                                                 ToolTip="Ara: ad, kimlik, kategori, anahtar kelime, üretici, model (birden çok kelime)" />
                                        <ComboBox ItemsSource="{Binding Manufacturers}" SelectedItem="{Binding Manufacturer}" Margin="8,0,8,4"
                                                  Visibility="{Binding IsDeviceMode, Converter={StaticResource BoolToVis}}" ToolTip="Üretici süzgeci" />
                                    </StackPanel>
                                    <Grid DataContext="{Binding Library}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TreeView ItemsSource="{Binding Roots}" BorderThickness="0" Background="Transparent"
                                                  SelectedItemChanged="OnLibrarySelectedItemChanged"
                                                  PreviewMouseLeftButtonDown="OnLibraryMouseDown" PreviewMouseMove="OnLibraryMouseMove">
                                            <TreeView.Resources>
                                                <HierarchicalDataTemplate DataType="{x:Type vm:LibraryNodeViewModel}" ItemsSource="{Binding Children}">
                                                    <TextBlock Text="{Binding Header}" FontWeight="SemiBold" Foreground="{StaticResource SelectionBrush}" />
                                                </HierarchicalDataTemplate>
                                                <DataTemplate DataType="{x:Type vm:LibraryItemViewModel}">
                                                    <StackPanel Orientation="Horizontal" ToolTip="{Binding Details}" Background="Transparent">
                                                        <Border Width="22" Height="22" Background="White" CornerRadius="2" Margin="0,1,6,1">
                                                            <Image Source="{Binding Preview}" Stretch="Uniform" Margin="1" />
                                                        </Border>
                                                        <TextBlock Text="★" Foreground="#FFFFB300" Margin="0,0,3,0" VerticalAlignment="Center"
                                                                   Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVis}}" />
                                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </TreeView.Resources>
                                            <TreeView.ItemContainerStyle>
                                                <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay, FallbackValue=False}" />
                                                </Style>
                                            </TreeView.ItemContainerStyle>
                                        </TreeView>
                                        <!-- Önizleme ve ayrıntı -->
                                        <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="8,6"
                                                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                                            <DockPanel DataContext="{Binding Selected}">
                                                <Border DockPanel.Dock="Left" Width="84" Height="84" Background="White" CornerRadius="3" Margin="0,0,8,0">
                                                    <Image Source="{Binding Preview}" Stretch="Uniform" Margin="4" />
                                                </Border>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Category}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Details}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,4" />
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="Yerleştir" Padding="8,1" Margin="0,0,6,0"
                                                                Command="{Binding DataContext.Library.PlaceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                        <Button Content="★ Favori" Padding="8,1" ToolTip="Favorilere ekle / çıkar"
                                                                Command="{Binding DataContext.Library.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </Grid>
                                </DockPanel>
                            </ad:LayoutAnchorable>
                        </ad:LayoutAnchorablePane>
                    </ad:LayoutAnchorablePaneGroup>

                    <ad:LayoutPanel Orientation="Vertical">
                        <ad:LayoutDocumentPane>
                            <ad:LayoutDocument ContentId="canvas" Title="Çizim alanı" CanClose="False" CanFloat="False">
                                <Border x:Name="CanvasPanel" Background="{StaticResource WorkspaceBrush}">
                                <draw:DrawingCanvas x:Name="Canvas"
                                                    Session="{Binding Session}"
                                                    ActiveTool="{Binding ActiveTool, Mode=TwoWay}"
                                                    PendingSymbol="{Binding SelectedSymbol}"
                                                    PendingImage="{Binding PendingImage}"
                                                    PendingConnector="{Binding PendingConnector}"
                                                    PendingDevice="{Binding PendingDevice}"
                                                    PendingPin="{Binding PendingPin}"
                                                    Colors="{Binding ColorScheme}"
                                                    HighlightedObjects="{Binding BottomPanel.Highlighted}">
                                    <!-- Tek tuş kısayolları yalnızca çizim alanı odaktayken çalışır (metin kutularında yazmayı engellemez) -->
                                    <draw:DrawingCanvas.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Kes" Command="{Binding CutCommand}" InputGestureText="Ctrl+X" />
                                            <MenuItem Header="Kopyala" Command="{Binding CopyCommand}" InputGestureText="Ctrl+C" />
                                            <MenuItem Header="Yapıştır" Command="{Binding PasteCommand}" InputGestureText="Ctrl+V" />
                                            <MenuItem Header="Sil" Command="{Binding DeleteCommand}" InputGestureText="Del" />
                                            <Separator />
                                            <MenuItem Header="Döndür 90°" Command="{Binding RotateCommand}" InputGestureText="R" />
                                            <Separator />
                                            <MenuItem Header="Tümünü seç" Command="{Binding SelectAllCommand}" InputGestureText="Ctrl+A" />
                                            <MenuItem Header="Sayfaya sığdır" Command="{Binding ZoomFitCommand}" InputGestureText="F" />
                                        </ContextMenu>
                                    </draw:DrawingCanvas.ContextMenu>
                                    <draw:DrawingCanvas.InputBindings>
                                        <KeyBinding Key="Left" Command="{Binding NudgeCommand}" CommandParameter="Left" />
                                        <KeyBinding Key="Right" Command="{Binding NudgeCommand}" CommandParameter="Right" />
                                        <KeyBinding Key="Up" Command="{Binding NudgeCommand}" CommandParameter="Up" />
                                        <KeyBinding Key="Down" Command="{Binding NudgeCommand}" CommandParameter="Down" />
                                        <KeyBinding Key="Left" Modifiers="Shift" Command="{Binding NudgeCommand}" CommandParameter="Left:fine" />
                                        <KeyBinding Key="Right" Modifiers="Shift" Command="{Binding NudgeCommand}" CommandParameter="Right:fine" />
                                        <KeyBinding Key="Up" Modifiers="Shift" Command="{Binding NudgeCommand}" CommandParameter="Up:fine" />
                                        <KeyBinding Key="Down" Modifiers="Shift" Command="{Binding NudgeCommand}" CommandParameter="Down:fine" />
                                        <KeyBinding Key="Delete" Command="{Binding DeleteCommand}" />
                                        <KeyBinding Key="R" Command="{Binding RotateCommand}" />
                                        <KeyBinding Key="F" Command="{Binding ZoomFitCommand}" />
                                        <KeyBinding Key="PageDown" Command="{Binding NextPageCommand}" />
                                        <KeyBinding Key="PageUp" Command="{Binding PreviousPageCommand}" />
                                        <KeyBinding Key="S" Command="{Binding SetToolCommand}" CommandParameter="Select" />
                                        <KeyBinding Key="L" Command="{Binding SetToolCommand}" CommandParameter="Line" />
                                        <KeyBinding Key="T" Command="{Binding SetToolCommand}" CommandParameter="Text" />
                                        <KeyBinding Key="J" Command="{Binding SetToolCommand}" CommandParameter="Tee" />
                                        <KeyBinding Key="D" Command="{Binding SetToolCommand}" CommandParameter="Angle" />
                                    </draw:DrawingCanvas.InputBindings>
                                </draw:DrawingCanvas>
                                </Border>
                            </ad:LayoutDocument>
                        </ad:LayoutDocumentPane>
                        <ad:LayoutAnchorablePane DockHeight="220">
                            <ad:LayoutAnchorable ContentId="drc" Title="DRC" CanClose="False" CanHide="True">
                                <Grid x:Name="DrcPanel" Background="{StaticResource PanelBrush}">
                                    <Grid DataContext="{Binding BottomPanel}">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top" Margin="6,4">
                                        <Button Content="DRC çalıştır (F7)" Command="{Binding RunDrcCommand}" Padding="10,2" Margin="0,0,6,0" />
                                        <Button Content="Temizle" Command="{Binding ClearDrcCommand}" Padding="10,2" Margin="0,0,12,0" />
                                        <TextBlock Text="{Binding DrcSummary}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Disclaimer}" TextWrapping="Wrap" FontSize="11"
                                               Foreground="#FFFFB74D" Margin="6,2,6,4" />
                                    <DataGrid ItemsSource="{Binding Findings}" SelectedItem="{Binding SelectedFinding}" AutoGenerateColumns="False" IsReadOnly="True"
                                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" MouseDoubleClick="OnFindingDoubleClick"
                                              ToolTip="Çift tık: ilgili sayfaya git ve nesneleri seç">
                                        <DataGrid.RowStyle>
                                            <Style TargetType="DataGridRow">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SeverityText}" Value="Hata">
                                                        <Setter Property="Foreground" Value="#FFD32F2F" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SeverityText}" Value="Uyarı">
                                                        <Setter Property="Foreground" Value="#FFE68A00" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGrid.RowStyle>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Önem" Binding="{Binding SeverityText}" Width="60" />
                                            <DataGridTextColumn Header="Kod" Binding="{Binding Code}" Width="100" />
                                            <DataGridTextColumn Header="Konum" Binding="{Binding Location}" Width="70" />
                                            <DataGridTextColumn Header="Açıklama" Binding="{Binding Message}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                                    </Grid>
                                </Grid>
                            </ad:LayoutAnchorable>
                            <ad:LayoutAnchorable ContentId="messages" Title="Mesajlar" CanClose="False" CanHide="True">
                                <Grid x:Name="MessagesPanel" Background="{StaticResource PanelBrush}">
                                    <Grid DataContext="{Binding BottomPanel}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Top" HorizontalAlignment="Left" Content="Temizle" Command="{Binding ClearMessagesCommand}" Padding="10,2" Margin="6,4" />
                                    <ListView ItemsSource="{Binding Messages}" BorderThickness="0">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Time}" Foreground="{StaticResource MutedTextBrush}" Width="64" />
                                                    <TextBlock Text="{Binding Text}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </DockPanel>
                                    </Grid>
                                </Grid>
                            </ad:LayoutAnchorable>
                            <ad:LayoutAnchorable ContentId="xref" Title="Çapraz referanslar" CanClose="False" CanHide="True">
                                <Grid x:Name="XrefPanel" Background="{StaticResource PanelBrush}">
                                    <Grid DataContext="{Binding BottomPanel}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Top" HorizontalAlignment="Left" Content="Yenile" Command="{Binding RefreshCommand}" Padding="10,2" Margin="6,4" />
                                    <DataGrid ItemsSource="{Binding CrossReferences}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Etiket" Binding="{Binding Reference}" Width="80" />
                                            <DataGridTextColumn Header="Açıklama" Binding="{Binding Description}" Width="200" />
                                            <DataGridTextColumn Header="Parçalar" Binding="{Binding Parts}" Width="*" />
                                            <DataGridTextColumn Header="Konumlar" Binding="{Binding Locations}" Width="160" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                                    </Grid>
                                </Grid>
                            </ad:LayoutAnchorable>
                            <ad:LayoutAnchorable ContentId="projectinfo" Title="Proje bilgisi" CanClose="False" CanHide="True">
                                <Grid x:Name="InfoPanel" Background="{StaticResource PanelBrush}">
                                    <Grid DataContext="{Binding BottomPanel}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Top" HorizontalAlignment="Left" Content="Yenile" Command="{Binding RefreshCommand}" Padding="10,2" Margin="6,4" />
                                    <DataGrid ItemsSource="{Binding ProjectInfo}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="None" GridLinesVisibility="Horizontal">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Binding="{Binding Key}" Width="180" />
                                            <DataGridTextColumn Binding="{Binding Value}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                                    </Grid>
                                </Grid>
                            </ad:LayoutAnchorable>
                        </ad:LayoutAnchorablePane>
                    </ad:LayoutPanel>

                    <ad:LayoutAnchorablePane DockWidth="310">
                        <ad:LayoutAnchorable ContentId="properties" Title="Özellikler" CanClose="False" CanHide="True">
                            <DockPanel x:Name="PropertiesPanel" Background="{StaticResource PanelBrush}">
                            <TextBlock DockPanel.Dock="Top" Text="{Binding Properties.Header}" FontSize="15" FontWeight="SemiBold" Margin="10,0,10,6" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Properties.Rows}" Margin="10,0,10,10" KeyboardNavigation.TabNavigation="Cycle" />
                            </ScrollViewer>
                            </DockPanel>
                        </ad:LayoutAnchorable>
                    </ad:LayoutAnchorablePane>
                </ad:LayoutPanel>
            </ad:LayoutRoot>
        </ad:DockingManager>
    </DockPanel>
</Window>
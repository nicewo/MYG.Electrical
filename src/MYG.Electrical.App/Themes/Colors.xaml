<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- MYG Electrical: koyu antrasit arayüz, mavi seçim, turuncu aktif araç -->
    <Color x:Key="AnthraciteColor">#FF1E1F22</Color>
    <Color x:Key="PanelColor">#FF26282C</Color>
    <Color x:Key="PanelHeaderColor">#FF2E3035</Color>
    <Color x:Key="BorderColor">#FF3A3D43</Color>
    <Color x:Key="WorkspaceColor">#FF3B3E44</Color>
    <Color x:Key="TextColor">#FFE4E6EB</Color>
    <Color x:Key="MutedTextColor">#FF9DA2AB</Color>
    <Color x:Key="SelectionColor">#FF2F80ED</Color>
    <Color x:Key="ActiveToolColor">#FFF28C28</Color>

    <SolidColorBrush x:Key="AnthraciteBrush" Color="{StaticResource AnthraciteColor}" />
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
    <SolidColorBrush x:Key="PanelHeaderBrush" Color="{StaticResource PanelHeaderColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="WorkspaceBrush" Color="{StaticResource WorkspaceColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}" />
    <SolidColorBrush x:Key="SelectionBrush" Color="{StaticResource SelectionColor}" />
    <SolidColorBrush x:Key="ActiveToolBrush" Color="{StaticResource ActiveToolColor}" />
</ResourceDictionary>
